# Configuración de Flask
FLASK_ENV=production
SECRET_KEY=change_this_in_prod_super_secret_key_here
JWT_SECRET_KEY=change_this_jwt_secret_key_here

# Base de datos MongoDB
# Para Docker: usar el nombre del servicio 'mongo'
# Para desarrollo local: usar 'localhost'
MONGO_URI=mongodb://mongo:27017/aralar

# CORS - Orígenes permitidos (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,,http://localhost:8080,https://aralar-admin.netlify.app,https://lovable.dev

# Rate limiting
RATE_LIMIT_DEFAULT=100/hour

# Seguridad
SECURE_COOKIES=false
TALISMAN_FORCE_HTTPS=false

# Datos iniciales del administrador
SEED_ADMIN_EMAIL=admin@aralar.local
SEED_ADMIN_PASSWORD=ChangeMeNow!2025
SEED_ADMIN_FULLNAME="Admin Aralar"

# Configuración de traducción (opcional)
I18N_PROVIDER=nllb #deepl or google or nllb
DEEPL_API_KEY=
DEEPL_BASE_URL=
NLLB_BASE_URL=http://nllb:8000

# Configuración de Google Translate (opcional)
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://translation.googleapis.com/language/translate/v2

# Reseñas de Google (sección de opiniones de la landing)
# provider: manual = alta desde el panel | scraper = endpoint interno de Google Maps
GOOGLE_REVIEWS_PROVIDER=scraper
# Reseñas con menos estrellas que este umbral quedan en 'pending' para revisión manual
GOOGLE_REVIEWS_AUTO_APPROVE_MIN_RATING=4
# Identificación del local (solo con provider=scraper). Basta con UNA de las dos:
# pega la URL del local en Google Maps y el feature id se extrae solo.
GOOGLE_MAPS_PLACE_URL=
GOOGLE_MAPS_FEATURE_ID=0xd4e4fd0009c3ac9:0xb1b67f8e1477f9ac
GOOGLE_REVIEWS_LOCALE=es
GOOGLE_REVIEWS_MAX_PAGES=10
GOOGLE_REVIEWS_TIMEOUT=20

# Configuración S3/Object Storage (opcional - no necesario para funcionamiento básico)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio123
# S3_REGION=us-east-1
# S3_BUCKET=aralar-media