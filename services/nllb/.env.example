# Modelo a usar (no cambiar salvo que quieras el modelo grande de 1.3B)
MODEL_NAME=facebook/nllb-200-distilled-600M

# Idioma fuente por defecto (código NLLB)
SOURCE_LANG=spa_Latn

# Device: cpu | cuda  (cpu es suficiente para dev/pruebas)
DEVICE=cpu

# Directorio cache del modelo dentro del contenedor (mapeado a volumen Docker)
HF_HOME=/cache/huggingface

# Idiomas destino disponibles (código NLLB:Nombre, separados por coma)
# TARGET_LANGS=spa_Latn:Español,eng_Latn:Inglés,fra_Latn:Francés,...
